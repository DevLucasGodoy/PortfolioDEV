# Contact form delivery through Resend (server only). The sender must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <contato@example.com>
CONTACT_TO_EMAIL=your-email@example.com

# Password for the route gate (protectedRoutes in once-ui.config.ts). Required only if you protect routes.
PAGE_ACCESS_PASSWORD=

# Secret used to sign the auth cookie. REQUIRED whenever the password gate is used.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
